## 二、 核心对账与分成重算代码 (`reconciliation_engine.py`)

```python
import pandas as pd
import numpy as np

class FinOpsReconciliationEngine:
    """
    平台型业务多方分成结算与第三方支付流水自动化核对引擎
    适用场景：商业平台商户抽成、直播/商单分成、游戏联运流水分账核对
    """
    def __init__(self, tolerance: float = 10.0):
        self.tolerance = tolerance

    def run_reconciliation(
        self, 
        order_df: pd.DataFrame, 
        payment_df: pd.DataFrame, 
        contract_df: pd.DataFrame
    ) -> pd.DataFrame:
        # 1. 聚合业务端有效GMV流水（剔除退款、测试单与未完结订单）
        valid_orders = order_df[order_df['order_status'] == 'SETTLED']
        order_summary = valid_orders.groupby('partner_id').agg(
            gross_gmv=('order_amount', 'sum'),
            promo_subsidy=('platform_coupon', 'sum'),
            order_count=('order_id', 'count')
        ).reset_index()

        # 2. 聚合第三方支付渠道清分账单（实收资金与通道手续费）
        pay_summary = payment_df.groupby('partner_id').agg(
            channel_settled=('net_amount', 'sum'),
            channel_fee=('fee_amount', 'sum')
        ).reset_index()

        # 3. 拉通【业务端—支付端—合同规则库】三方数据
        df = pd.merge(order_summary, pay_summary, on='partner_id', how='outer').fillna(0)
        df = pd.merge(df, contract_df, on='partner_id', how='left')

        # 4. 结合合同条款（保底金额 MG vs 阶梯分成比例 Tiered Rate）自动重算平台应收分成
        def calculate_expected_share(row):
            net_base = row['gross_gmv'] - row['promo_subsidy']
            # 阶梯分成逻辑：超过阈值部分按高阶费率计算
            if net_base > row['tier_threshold']:
                tiered_rev = (row['tier_threshold'] * row['base_rate']) + \
                             ((net_base - row['tier_threshold']) * row['excess_rate'])
            else:
                tiered_rev = net_base * row['base_rate']
            return max(row['minimum_guarantee'], tiered_rev)

        df['expected_platform_rev'] = df.apply(calculate_expected_share, axis=1)

        # 5. 计算业财结算差异与支付清分差异，输出异常波动风险标签
        df['settlement_variance'] = df['expected_platform_rev'] - df['erp_booked_rev']
        df['cash_flow_variance'] = df['gross_gmv'] - (df['channel_settled'] + df['channel_fee'])

        df['audit_status'] = np.where(
            (df['settlement_variance'].abs() > self.tolerance) | 
            (df['cash_flow_variance'].abs() > self.tolerance),
            'ALERT_异常波动待穿透核查',
            'PASS_业财核对闭环'
        )
        return df.sort_values(by='settlement_variance', ascending=False)
